{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ripred-euclid",
  "marketingAssets": {
    "icon": "subreddit/images/euclid_app_profile_icon_1024.png"
  },
  "permissions": { "media": true, "journeys": true },
  "triggers": {
    "onAppInstall": "/internal/community/setup",
    "onAppUpgrade": "/internal/community/setup"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "preview.html",
        "height": "tall",
        "inline": true
      },
      "game": {
        "entry": "index.html"
      },
      "challenge": {
        "entry": "challenge.html"
      },
      "daily": {
        "entry": "daily.html"
      },
      "weekly": {
        "entry": "weekly.html"
      },
      "leaderboard": {
        "entry": "leaderboard.html"
      },
      "watch": {
        "entry": "watch.html"
      },
      "solo": {
        "entry": "solo.html"
      },
      "reddit": {
        "entry": "reddit.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "scheduler": {
    "tasks": {
      "challenge-maintenance": {
        "endpoint": "/internal/competitions/maintenance",
        "cron": "* * * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create Euclid Game Post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-post",
        "postFilter": "none"
      }
    ]
  },
  "dev": {
    "subreddit": "ripred_euclid_dev"
  }
}
