{
  "private": true,
  "name": "euclid",
  "version": "1.0.0",
  "description": "Euclid, a strategy game of squares against a computer opponent. A single-player web app for any modern browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run type-check && vite build",
    "check": "npm run type-check && npm run lint && npm run format:check && npm test",
    "dev": "vite --port 5173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "15.15.0",
    "jsdom": "24.1.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.0",
    "vite": "6.4.3",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
